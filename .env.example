# Copy this file to .env and fill in the values. NEVER commit .env.

# --- Circle (https://console.circle.com → API & Client Keys) ---
# Use a TESTNET API key.
CIRCLE_API_KEY=
# 64-char hex secret. Filled in by `npm run register-secret` (or the Circle Console).
CIRCLE_ENTITY_SECRET=

# --- Supabase (dashboard → Project Settings → API Keys) ---
# NEXT_PUBLIC_ vars are sent to the browser, so only the URL and the
# publishable key may have that prefix. The secret key must NEVER have it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... : server-only, bypasses Row Level Security.
SUPABASE_SECRET_KEY=
# Password for the demo users. Generated by `npm run seed` if empty.
DEMO_PASSWORD=

# --- Anthropic (Claude API, for invoice extraction) ---
# platform.claude.com → API Keys. Server-only.
ANTHROPIC_API_KEY=

# --- Wallets on ARC-TESTNET (printed by `npm run pay -- create-wallets`) ---
# Treasury = the company wallet that pays invoices.
TREASURY_WALLET_ID=
TREASURY_WALLET_ADDRESS=
# A test "contractor" wallet to receive payments while we test.
CONTRACTOR_WALLET_ADDRESS=

# --- Tutor agent wallet (filled in by `npm run make-agent-wallet`) ---
# Raw key used by Circle's GatewayClient to sign x402 payments. It only ever
# holds the agent's small test budget. Server-only, never NEXT_PUBLIC_.
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=

# Outside agent demo (scripts/outside-agent.ts), made by `npm run outside-agent -- setup`
OUTSIDE_AGENT_PRIVATE_KEY=
OUTSIDE_AGENT_ADDRESS=

# Meaning search (pgvector): Voyage AI embeddings key from voyageai.com
VOYAGE_API_KEY=
