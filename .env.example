# Copy this file to .env and fill in the values. NEVER commit .env.

# --- Circle (https://console.circle.com → API & Client Keys) ---
# Use a TESTNET API key.
CIRCLE_API_KEY=
# 64-char hex secret. Filled in by `npm run register-secret` (or the Circle Console).
CIRCLE_ENTITY_SECRET=

# --- Wallets on ARC-TESTNET (printed by `npm run pay -- create-wallets`) ---
# Treasury = the company wallet that pays invoices.
TREASURY_WALLET_ID=
TREASURY_WALLET_ADDRESS=
# A test "contractor" wallet to receive payments while we test.
CONTRACTOR_WALLET_ADDRESS=
